          <LN lnClass="LPHD" lnType="LPHD_Type" inst="1" prefix="">
            <DOI name="PhyNam" desc="Nombre fasico">
              <DAI name="vendor"><Val>TMW</Val></DAI>
              <DAI name="swRev"><Val>1.0</Val></DAI>
              <DAI name="location"><Val>POD_001</Val></DAI>
            </DOI>
            <DOI name="PhyHealth" desc="Salud fasica">
              <DAI name="stVal"><Val>Ok</Val></DAI>
            </DOI>
          </LN>
          <!-- ======================================================== -->
          <!-- DPCC - CARACTERISTICAS DE PLANTA (VALORES POR DEFECTO)    -->
