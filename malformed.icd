      <Hitem version="1" revision="05" when="23/07/2026 17:30:00" what="PF2 NotAvalable functions" who="RMS" why="Functional tests for PF2 related to Active Power, PF3 is out of scope, reduced number of inverters to 4, removed special characters" />	  
    </History>
  </Header>
  <Communication>
    <SubNetwork name="DSO_Subnetwork" type="8-MMS">
      <Text>IEC61850 CCI Interface with the DSO</Text>
      <BitRate unit="b/s">1000000</BitRate>
      <ConnectedAP iedName="CEI016_CTRL" apName="AP1">
        <Address>
          <P type="IP">192.168.2.164</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="IP-GATEWAY">192.168.2.1</P>
          <P type="OSI-TSEL">0001</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
          <P type="OSI-AP-Title">000</P>
          <P type="OSI-AE-Qualifier">000</P>
        </Address>
		<PhysConn type="Connection">
<!-- port name nome see Annex.O, just an example -->
			<P type="Port">Eth1</P>
		</PhysConn>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="CEI016_CTRL" engRight="full" manufacturer="TMW" configVersion="1.0" originalSclRevision="B" originalSclVersion="2007" originalSclRelease="4">
    <Services nameLength="64">
<!-- services and figures will be customized according to Conformance Statements -->
      <ClientServices goose="false" gsse="false" bufReport="false" unbufReport="false" readLog="false" sv="false" supportsLdName="true" rGOOSE="false" rSV="false" noIctBinding="false" >
        <TimeSyncProt sntp="true" c37_238="false" other="false" iec61850_9_3="false" />
      </ClientServices>
      <DynAssociation max="2"/> <!-- just an example, to be defined in PIXIT -->
      <GetDirectory />
      <GetDataObjectDefinition />
      <DataObjectDirectory />
      <GetDataSetValue />
      <DataSetDirectory />
      <ConfDataSet max="10" maxAttributes="200" modify="false" />
      <ReadWrite />
      <ConfReportControl max="10" bufMode="both" bufConf="false" />
      <GetCBValues />
      <ReportSettings cbName="Conf" datSet="Conf" rptID="Conf" optFields="Conf" bufTime="Conf" trgOps="Conf" intgPd="Conf" resvTms="true" owner="false" />
      <ConfLNs fixPrefix="true" fixLnInst="true" />
      <ConfLdName />
    </Services>
    <AccessPoint name="AP1">
      <Server>
        <Authentication />
        <!-- ======================================================== -->
        <!-- LDEVICE PRINCIPAL - LD_Plant                             -->
        <!-- ======================================================== -->
        <LDevice inst="LD_Plant" desc="Planta fotovoltaica - 18 inversores">
          <!-- ======================================================== -->
          <!-- LLN0 - NODO LOGICO CERO (DATASETS Y REPORTCONTROLS)      -->
          <!-- ======================================================== -->
          <LN0 lnClass="LLN0" lnType="LLN0_Type" inst="">
            <!-- DATA SET 1: Estados, alarmas y segnales -->
            <DataSet name="DS_Status" desc="Estados y alarmas">
              <!-- Disponibilidad de planta -->
              <FCDA ldInst="LD_Plant" lnClass="DPCC" fc="SP" lnInst="1" prefix="PdC_Wi" doName="WRtg" />
              <FCDA ldInst="LD_Plant" lnClass="DPCC" fc="SP" lnInst="1" prefix="PdC_Wa" doName="WRtg" />
              <FCDA ldInst="LD_Plant" lnClass="DPCC" fc="SP" lnInst="1" prefix="PdC_Qi" doName="VArRtg" />
              <FCDA ldInst="LD_Plant" lnClass="DPCC" fc="SP" lnInst="1" prefix="PdC_Qc" doName="VArRtg" />
              <FCDA ldInst="LD_Plant" lnClass="DPCC" fc="SP" lnInst="1" prefix="PdC_VA" doName="VARtg" />
              <FCDA ldInst="LD_Plant" lnClass="DECP" lnInst="1" prefix="DisFR" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="1" prefix="DisFR" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DSTO" lnInst="1" prefix="DisFR" fc="ST" doName="Beh" />
              <!-- Interruptor general -->
              <FCDA ldInst="LD_Plant" lnClass="XCBR" lnInst="1" prefix="IDG" fc="ST" doName="Pos" />
              <!-- Estado por inversor (18 instancias) -->
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="1" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="1" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="2" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="2" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="3" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="3" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="4" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="4" prefix="SSGG" doName="GnGrId" />
<!-- reduced number of inverters fo Functional Tests  
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="5" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="5" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="6" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="6" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="7" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="7" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="8" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="8" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="9" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="9" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="10" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="10" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="11" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="11" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="12" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="12" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="13" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="13" prefix="SSGG" doName="GnGrId" />              
			  <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="14" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="14" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="15" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="15" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="16" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="16" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="17" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="17" prefix="SSGG" doName="GnGrId" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="18" prefix="SSGG" fc="ST" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" fc="ST" lnInst="18" prefix="SSGG" doName="GnGrId" /> -->
              <!-- Estados de funciones de control DSO -->
              <FCDA ldInst="LD_Plant" lnClass="DWMX" lnInst="1" prefix="Wlim" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DWMX" fc="ST" lnInst="1" prefix="Wlim" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DWMX" lnInst="1" prefix="Wlim" fc="ST" doName="FctOpStAuto" />
              <FCDA ldInst="LD_Plant" lnClass="DWMX" lnInst="1" prefix="Wlim" fc="ST" doName="FctOpStEx" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="1" prefix="WSd" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" fc="ST" lnInst="1" prefix="WSd" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="1" prefix="WSd" fc="ST" doName="FctOpSt" />
<!-- Not required in functional tests on PF2 related to Active Power
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="1" prefix="VArSd" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" fc="ST" lnInst="1" prefix="VArSd" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="1" prefix="VArSd" fc="ST" doName="FctOpSt" />
              <FCDA ldInst="LD_Plant" lnClass="DFPF" lnInst="1" prefix="PFSP" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DFPF" fc="ST" lnInst="1" prefix="PFSP" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DFPF" lnInst="1" prefix="PFSP" fc="ST" doName="FctOpSt" />
              <FCDA ldInst="LD_Plant" lnClass="DVVR" lnInst="1" prefix="VArV" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DVVR" fc="ST" lnInst="1" prefix="VArV" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DVVR" lnInst="1" prefix="VArV" fc="ST" doName="FctOpSt" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" fc="ST" lnInst="1" prefix="PFW" doName="Health" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="ST" doName="FctOpSt" /> -->
              <!-- Estados funciones MSD (con FctOpSt) -->
<!-- PF3 is Out of Scope of the Functional Tests
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="2" prefix="WSa" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="2" prefix="WSa" fc="ST" doName="FctOpSt" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="2" prefix="VArSa" fc="ST" doName="Beh" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="2" prefix="VArSa" fc="ST" doName="FctOpSt" /> -->
            </DataSet>
            <!-- DATA SET 2: Medidas del punto de conexion (cada 4s) -->
            <DataSet name="DS_PdC_Measurements" desc="Medidas PdC cada 4s">
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="TotVAr" />
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="PPV" />
              <!-- current measurement is opzional -->
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="A" />
              <!-- 3 additional measurements, not required in the CCI               
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="TotVA" />
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="TotPF" />
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="PdC" fc="MX" doName="Hz" /> -->
            </DataSet>
            <!-- DATA SET 3: Medidas por tipo de fuente (cada 4s) -->
            <DataSet name="DS_Source_Measurements" desc="Medidas por fuente cada 4s">
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="GenPV" fc="MX" doName="TotW" />
            </DataSet>
            <!-- DATA SET 4: Medidas por inversor (cada 4s) + GnGrId -->
            <DataSet name="DS_Inverter_Measurements" desc="Medidas por inversor cada 4s">
              <!-- Inversor 1 -->
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="1" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="1" prefix="SSGG" fc="ST" doName="GnGrId" />
              <!-- Inversor 2 -->
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="2" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="2" prefix="SSGG" fc="ST" doName="GnGrId" />
              <!-- Inversor 3 -->
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="3" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="3" prefix="SSGG" fc="ST" doName="GnGrId" />
              <!-- Inversor 4 -->
              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="4" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="4" prefix="SSGG" fc="ST" doName="GnGrId" />
              <!-- reduced number of inverters for Functional Tests -->  
              <!-- Inversor 5 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="5" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="5" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 6 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="6" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="6" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 7 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="7" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="7" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 8 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="8" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="8" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 9 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="9" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="9" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 10 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="10" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="10" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 11 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="11" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="11" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 12 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="12" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="12" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 13 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="13" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="13" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 14 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="14" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="14" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 15 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="15" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="15" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 16 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="16" prefix="SGG" fc="MX" doName="TotW" />
              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="16" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
              <!-- Inversor 17 --> 
<!--              <FCDA ldInst="LD_Plant" lnClass="MMXU" lnInst="17" prefix="SGG" fc="MX" doName="TotW" />
