          <LN lnClass="DPCC" lnType="DPCC1_Type" inst="1" prefix="PdC_Wi" desc="Potencia activa maxima en inyeccion">
            <DOI name="NamPlt">
              <DAI name="lnNs">
                <Val>IEC 61850-7-420:2019A</Val>
              </DAI>
            </DOI>
            <DOI name="Beh" desc="">
              <DAI name="stVal">
                <Val>on</Val>
              </DAI>
            </DOI>
            <DOI name="WRtg" desc="Pmax inyeccion">
              <SDI name="setMag"><DAI name="f"><Val>1000</Val></DAI></SDI>
            </DOI>
          </LN>
          <LN lnClass="DPCC" lnType="DPCC1_Type" inst="1" prefix="PdC_Wa" desc="Potencia activa maxima en absorcion">
