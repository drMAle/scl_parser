<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sxy="http://www.iec.ch/61850/2003/SCLcoordinates" xsi:schemaLocation="http://www.iec.ch/61850/2003/SCL SCL.xsd" xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B" release="4">
  <Header id="CEI016_FULL_MSD_COMPLETE" version="1" revision="05" toolID="TMW Engineering" nameStructure="IEDName">
    <History>
      <Hitem version="1" revision="01" when="17/03/2026 15:30:00" what="ICD completo para parque solar con 18 inversores y funciones MSD" who="TMW" why="Certificacion CEI 0-16 con recepcion de setpoints" />
      <Hitem version="1" revision="02" when="14/05/2026 15:15:00" what="ICD completo para parque solar con 18 inversores y funciones MSD" who="RMS" why="Certificacion CEI 0-16 con recepcion de setpoints" />
