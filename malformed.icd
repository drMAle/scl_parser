              <FCDA ldInst="LD_Plant" lnClass="DVVR" lnInst="1" prefix="VArV" fc="CF" doName="Mod" />
              <FCDA ldInst="LD_Plant" lnClass="DVVR" lnInst="1" prefix="VArV" fc="SP" doName="K" />
              <FCDA ldInst="LD_Plant" lnClass="DPMC" lnInst="1" prefix="VArV" fc="MX" doName="WSpt1" />
              <FCDA ldInst="LD_Plant" lnClass="DPMC" lnInst="2" prefix="VArV" fc="MX" doName="WSpt1" />
              <FCDA ldInst="LD_Plant" lnClass="DECP" lnInst="1" prefix="VArV" fc="SP" doName="VMax" />
