              <FCDA ldInst="LD_Plant" lnClass="DECP" lnInst="2" prefix="VArV" fc="SP" doName="VMax" />
              <FCDA ldInst="LD_Plant" lnClass="DECP" lnInst="2" prefix="VArV" fc="SP" doName="VMin" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="CF" doName="Mod" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="WSetA" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="PFSetA" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="WSetB" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="PFSetB" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="WSetC" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="PFSetC" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="VLkIn" />
              <FCDA ldInst="LD_Plant" lnClass="DPFW" lnInst="1" prefix="PFW" fc="SP" doName="VLkOut" /> -->
            </DataSet>
            <!-- DATA SET 8: Control MSD (Aggregatore) - CON TODOS LOS COMANDOS -->
<!-- PF3 not Concerning the Functional Tests
            <DataSet name="DS_MSD_Control" desc="Comandos Aggregatore">
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="2" prefix="WSa" fc="CF" doName="WSptPct" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="2" prefix="WSa" fc="CF" doName="Mod" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="2" prefix="VArSa" fc="CF" doName="VArTgtSptPct" />
              <FCDA ldInst="LD_Plant" lnClass="DVAR" lnInst="2" prefix="VArSa" fc="CF" doName="Mod" />
            </DataSet> -->
            <!-- ======================================================== -->
            <!-- REPORT CONTROLS                                          -->
            <!-- ======================================================== -->
            <!-- ReportControl 1: Estados (buffered, por cambio) -->
            <ReportControl name="brcb_Status" datSet="DS_Status" buffered="true" confRev="2" indexed="true" intgPd="0" bufTime="250" desc="Estados por cambio">
              <TrgOps dchg="true" qchg="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="true" configRef="true" bufOvfl="true" />
              <RptEnabled max="2" desc="Clientes DSO" />
            </ReportControl>
            <!-- ReportControl 2: Medidas PdC (unbuffered, cada 4s) -->
            <ReportControl name="urcb_PdC_Measurements" datSet="DS_PdC_Measurements" buffered="false" confRev="2" indexed="true" intgPd="4000" bufTime="0" desc="Medidas PdC cada 4s">
              <TrgOps period="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="true" configRef="true" />
              <!-- Just an example coherent with Services section -->
              <RptEnabled max="2" desc="Clientes DSO" />
            </ReportControl>
            <!-- ReportControl 3: Medidas por fuente (unbuffered, cada 4s) -->
            <ReportControl name="urcb_Source_Measurements" datSet="DS_Source_Measurements" buffered="false" confRev="1" indexed="true" intgPd="4000" bufTime="0" desc="Medidas por fuente cada 4s">
              <TrgOps period="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="true" configRef="true" />
              <!-- Just an example coherent with Services section -->
              <RptEnabled max="2" desc="Clientes DSO" />
            </ReportControl>
            <!-- ReportControl 4: Medidas por inversor (unbuffered, cada 4s) -->
            <ReportControl name="urcb_Inverter_Measurements" datSet="DS_Inverter_Measurements" buffered="false" confRev="2" indexed="true" intgPd="4000" bufTime="0" desc="Medidas por inversor cada 4s">
              <TrgOps period="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="true" configRef="true" />
              <!-- Just an example coherent with Services section -->
              <RptEnabled max="2" desc="Clientes DSO" />
            </ReportControl>
            <!-- ReportControl 5: Energias (unbuffered, cada 10s) -->
            <!-- removed, not required in the CCI -->
            <!-- ======================================================== -->
            <!-- DATOS DEL NODO LLN0                                       -->
            <!-- ======================================================== -->
            <DOI name="Mod" desc="Modo de operacion">
              <DAI name="stVal"><Val>on</Val></DAI>
              <DAI name="ctlModel">
                <Val>status-only</Val>
              </DAI>
            </DOI>
            <DOI name="Beh" desc="Comportamiento">
              <DAI name="stVal"><Val>on</Val></DAI>
            </DOI>
            <DOI name="Health" desc="Salud">
              <DAI name="stVal"><Val>Ok</Val></DAI>
            </DOI>
            <DOI name="NamPlt" desc="Placa">
              <DAI name="ldNs">
                <Val>IEC 61850-7-4:2007</Val>
              </DAI>
              <DAI name="configRev">
                <Val>V.1.5</Val>
              </DAI>
            </DOI>
          </LN0>
          <!-- ======================================================== -->
          <!-- LPHD - INFORMACION DEL DISPOSITIVO FASICO                -->
