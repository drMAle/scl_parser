            <DOI name="WSetB" desc="Punto B P"><DAI name="setMag.f"><Val>0.5</Val></DAI></DOI>
            <DOI name="PFSetB" desc="Punto B PF"><DAI name="setMag.f"><Val>1.0</Val></DAI></DOI>
            <DOI name="WSetC" desc="Punto C P"><DAI name="setMag.f"><Val>1.0</Val></DAI></DOI>
            <DOI name="PFSetC" desc="Punto C PF"><DAI name="setMag.f"><Val>0.95</Val></DAI></DOI>
            <DOI name="VLkIn" desc="Lock-in tension"><DAI name="setMag.f"><Val>1.05</Val></DAI></DOI>
            <DOI name="VLkOut" desc="Lock-out tension"><DAI name="setMag.f"><Val>0.98</Val></DAI></DOI> -->
          </LN>

<!-- PF3 Not concerning the Functional Tests -->
          <!-- ======================================================== -->
          <!-- FUNCIONES DE CONTROL MSD (AGGREGATORE) - COMPLETAS        -->
          <!-- ======================================================== -->
          <!-- DAGC instancia 2 - Setpoint P MSD (CON FctOpSt ANADIDO) -->
<!--          <LN lnClass="DAGC" lnType="DAGC_Type" inst="2" prefix="WSa" desc="Set point P para MSD">
            <DOI name="Beh" desc="Comportamiento"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="FctOpSt" desc="Estado funcion MSD P"><DAI name="stVal"><Val>2</Val></DAI></DOI>
            <DOI name="WSptPct" desc="Setpoint P para MSD"><DAI name="ctlVal"><Val>0</Val></DAI></DOI>
            <DOI name="Mod" desc="Modo funcion"><DAI name="ctlVal"><Val>on</Val></DAI></DOI>
          </LN> -->
          <!-- DVAR instancia 2 - Setpoint Q MSD (CON FctOpSt ANADIDO) -->
<!--         <LN lnClass="DVAR" lnType="DVAR_Type" inst="2" prefix="VArSa" desc="Set point Q para MSD">
            <DOI name="Beh" desc="Comportamiento"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="FctOpSt" desc="Estado funcion MSD Q"><DAI name="stVal"><Val>2</Val></DAI></DOI>
            <DOI name="VArTgtSptPct" desc="Setpoint Q para MSD"><DAI name="ctlVal"><Val>0</Val></DAI></DOI>
            <DOI name="Mod" desc="Modo funcion"><DAI name="ctlVal"><Val>on</Val></DAI></DOI>
          </LN> -->
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>
