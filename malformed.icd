              <FCDA ldInst="LD_Plant" lnClass="DGEN" lnInst="18" prefix="SSGG" fc="ST" doName="GnGrId" />  -->
            </DataSet>
            <!-- DATA SET 5: Energias -->
            <!-- removed, not required in the CCI -->
            <!-- DATA SET 6: Caracteristicas de planta (DPCC) -->
            <!-- included in the DS_Status -->
            <!-- DATA SET 7: Control DSO (comandos) -->
			<!-- optional dataset, only if required by a specific DSO -->
            <DataSet ame="DS_DSO_Control" desc="Comandos DSO">
              <FCDA ldInst="LD_Plant" lnClass="DWMX" lnInst="1" prefix="Wlim" fc="MX" doName="WMaxSptPct" />
              <FCDA ldInst="LD_Plant" lnClass="DWMX" lnInst="1" prefix="Wlim" fc="CF" doName="Mod" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="1" prefix="WSd" fc="MX" doName="WSptPct" />
              <FCDA ldInst="LD_Plant" lnClass="DAGC" lnInst="1" prefix="WSd" fc="CF" doName="Mod" />
